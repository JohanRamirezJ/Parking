# Copia este archivo como .env y ajusta los valores. No subas .env al repositorio.
POSTGRES_DB=smartpark
POSTGRES_USER=smartpark
POSTGRES_PASSWORD=smartpark
DB_PORT=5433
API_PORT=5000
WEB_PORT=8080

SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_SECRET=cambia-esto-por-otro-valor-largo-y-aleatorio

# 1 = carga parqueaderos de ejemplo y usuarios demo (admin@smartpark.co / admin12345)
SEED_DEMO=1
# Opcional: crea o actualiza un administrador propio al arrancar
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: el chat redacta respuestas con el modelo de lenguaje
OPENAI_API_KEY=
