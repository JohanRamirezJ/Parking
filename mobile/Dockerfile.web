# SmartPark — app Flutter compilada para web y servida con nginx
FROM ghcr.io/cirruslabs/flutter:stable AS build
ARG API_URL=http://localhost:5000
WORKDIR /src
COPY pubspec.yaml analysis_options.yaml ./
COPY lib ./lib
COPY test ./test
# Genera la carpeta web/ (el repo solo trae el código Dart) y compila
RUN flutter create . --org co.smartpark --project-name smartpark --platforms=web \
 && rm -f test/widget_test.dart \
 && flutter pub get \
 && flutter build web --release --dart-define=API_URL=${API_URL}

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/build/web /usr/share/nginx/html
EXPOSE 80
