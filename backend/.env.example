# Copiar a .env y ajustar. Nunca subir .env al repositorio.
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
JWT_EXP_MINUTES=1440

# Desarrollo: SQLite (por defecto). Producción: PostgreSQL
# DATABASE_URL=postgresql+psycopg://smartpark:smartpark@db:5432/smartpark

# Opcional: si se define, el chat redacta las respuestas con el modelo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Módulo de IA: supuestos del costo de manejar (opcionales)
PRECIO_GALON_COP=16331
RENDIMIENTO_KM_GALON=30
COSTO_RODAMIENTO_KM=250
VELOCIDAD_AUTO_KMH=18
